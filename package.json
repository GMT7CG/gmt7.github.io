{
  "name": "gmt7.github.io",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:security": "tools/eslint/node_modules/.bin/eslint -c tools/eslint/eslint.config.mjs src scripts",
    "test": "jest --no-watchman",
    "compile": "tsc --noEmit",
    "validate:schemas": "tsx scripts/validate-schemas.ts",
    "dupes": "jscpd src --threshold 2",
    "test:e2e": "playwright test",
    "verify:dev": "npm run lint && npm run test && npm run lint:security && npm run compile && npm run validate:schemas && npm run dupes && npm run test:e2e"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "jscpd": "^5.3.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "^13.0.6"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
